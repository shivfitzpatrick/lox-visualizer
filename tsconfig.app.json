{
    "compilerOptions": {
	"composite": true,
	"strict": true,
	"noEmit": true,
	"noUnusedLocals": true,
	"noUnusedParameters": true,
	"module": "ESNext",
	"moduleResolution": "bundler",
	"skipLibCheck": true,
	"target": "ESNext",
	"paths": {
	    "@/*": ["./src/*"],
	    "/js/lox-visualizer/lox.js": ["./src/types/lox-wasm-stub.ts"]
	},
	"lib": ["ESNext", "DOM", "DOM.Iterable"]
    },
    "include": ["src/**/*"],
    "exclude": ["src/**/*.test.ts"]
}
